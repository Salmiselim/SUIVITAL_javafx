<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<DialogPane prefHeight="555.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AddCommentController"
            style="-fx-background-color: #f8f9fa;">

    <!-- En-tête stylé -->
    <header>
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#388e3c" height="80.0" width="600.0"/>
        <StackPane alignment="CENTER_LEFT" style="-fx-padding: 20;">
            <Label text="New Comment" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <Label text="Share your thoughts" layoutY="30.0" textFill="#e0f7fa">
                <font>
                    <Font name="System Italic" size="14.0"/>
                </font>
            </Label>
        </StackPane>
    </header>

    <!-- Contenu principal -->
    <content>
        <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="30.0"/>
            </padding>

            <!-- Champ Auteur -->
            <VBox spacing="5.0">
                <Label text="Author*" textFill="#388e3c">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Label>
                <TextField fx:id="authorField" prefHeight="40.0" prefWidth="500.0"
                           promptText="Your name"
                           style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5;"/>
            </VBox>

            <!-- Champ Commentaire -->
            <VBox spacing="5.0" style="-fx-padding: 15 0 0 0;">
                <Label text="Comment*" textFill="#388e3c">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Label>
                <TextArea fx:id="commentContent" prefHeight="150.0" prefWidth="500.0"
                          promptText="Your comment here..."
                          style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5;"
                          wrapText="true"/>
            </VBox>

            <!-- Boutons personnalisés -->
            <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 20 0 0 0;">
                <Button fx:id="submitButton" mnemonicParsing="false" onAction="#handleSubmit"
                        prefHeight="45.0" prefWidth="150.0"
                        style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;"
                        text="Publish"/>

                <Button fx:id="clearButton" mnemonicParsing="false" onAction="#handleClear"
                        prefHeight="45.0" prefWidth="150.0"
                        style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;"
                        text="Clear"/>
            </HBox>

            <!-- Note -->
            <Label text="* required field" textFill="#757575" style="-fx-padding: 10 0 0 0;"/>
        </VBox>
    </content>
</DialogPane>