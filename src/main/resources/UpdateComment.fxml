<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UpdateCommentController">
    <children>
        <!-- En-tête avec couleur verte -->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#388e3c" height="80.0" layoutX="0.0" layoutY="0.0" stroke="BLACK" strokeType="INSIDE" width="600.0" />
        <Label layoutX="20.0" layoutY="20.0" text="Edit Comment" textFill="WHITE">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <!-- Conteneur principal pour le formulaire -->
        <VBox alignment="TOP_CENTER" layoutX="100.0" layoutY="80.0" spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- Champ Auteur -->
            <VBox spacing="5.0">
                <Label text="Author:" textFill="#388e3c">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="authorField" prefHeight="35.0" prefWidth="400.0" style="-fx-background-radius: 5;" />
            </VBox>

            <!-- Champ Contenu -->
            <VBox spacing="5.0">
                <Label text="Comment:" textFill="#388e3c">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextArea fx:id="contentArea" prefHeight="150.0" prefWidth="400.0" style="-fx-background-radius: 5;" wrapText="true" />
            </VBox>

            <!-- Boutons -->
            <HBox alignment="CENTER" spacing="20.0">
                <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleUpdate" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-background-radius: 5;" text="Save" />
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #b71c1c; -fx-text-fill: white; -fx-background-radius: 5;" text="Cancel" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>